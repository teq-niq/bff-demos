<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>eg</groupId>
  <artifactId>bff-demos</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
		<java.version>24</java.version>
		<nodeVersion>v24.0.0</nodeVersion>
		<nodeInstallDir>${maven.multiModuleProjectDirectory}</nodeInstallDir>
		<spring.boot.version>3.5.9</spring.boot.version>
		<sw.ui.version>5.32.8</sw.ui.version>
		<okta.spring.boot.starter.version>3.0.8</okta.spring.boot.starter.version>
	</properties>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
	
		<module>simple.bff</module>

		<module>oidc.bff</module>
		<module>okta-setup-for-oidc</module>
	</modules>
	<dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-dependencies</artifactId>
      <version>${spring.boot.version}</version>
      <type>pom</type>
      <scope>import</scope>
    </dependency>
  </dependencies>
</dependencyManagement>
 <dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		
		<dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.14</version>
      <exclusions>

      	<exclusion>
      		<groupId>org.webjars</groupId>
      		<artifactId>swagger-ui</artifactId>
      	</exclusion>
      </exclusions>
		</dependency>
		
		<dependency>
     <groupId>io.github.teq-niq</groupId>
  <artifactId>swagger-ui-bff</artifactId>
  <version>5.32.8-bff-1.0.0-SNAPSHOT</version>
    </dependency>
   
	</dependencies>
<build>
 
	<resources>
	
        <resource>
            <directory>${project.basedir}/src/main/resources</directory>
        </resource>
        
        <resource>
            <directory>${project.build.directory}/src/main/angular-dist</directory>
        </resource>

     <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/application.properties</include>
                    <include>**/application*.yml</include>
                </includes>
            </resource>
    </resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>${java.version}</release>
				</configuration>
			</plugin>
		 
		</plugins>
	</build>
	<profiles>
        <profile>
            <id>npmbuild</id>
           <build>
	<plugins>

					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.15.4</version>
						<configuration>
							<nodeVersion>${nodeVersion}</nodeVersion>
						</configuration>
						<executions>
						
					
							<execution>
								<id>install node and npm -for- angular-front-end</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>install-node-and-npm</goal>
								</goals>
								<configuration>
									
									<installDirectory>${nodeInstallDir}</installDirectory>
								</configuration>
							</execution>
							
							<execution>
								<id>npm install - angular-front-end</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>npm</goal>
								</goals>
								<configuration>
									<workingDirectory>${project.basedir}/angular-front-end</workingDirectory>
									<installDirectory>${nodeInstallDir}</installDirectory>
									
									<skip>${angular-build-skip}</skip>
								</configuration>
							</execution>
							
							<execution>
								<id>npx ng build for angular</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>npx</goal>
								</goals>
								<configuration>
									<arguments>ng build --output-path=${project.build.directory}/src/main/angular-dist/</arguments>
									<workingDirectory>${project.basedir}/angular-front-end</workingDirectory>
									<installDirectory>${nodeInstallDir}</installDirectory>
									<skip>${angular-build-skip}</skip>
								</configuration>
							</execution>
							
							
						</executions>
					</plugin>	
		</plugins>
	</build>
        </profile>
       <profile>
    <id>angular-build-activation</id>
    <activation>
      <file>
        <missing>${project.basedir}/angular-front-end/package.json</missing>
      </file>
    </activation>
	<properties>
    <angular-build-skip>true</angular-build-skip>
    
  </properties>
  </profile>
<profile>
            <id>berun</id>
            
           <build>
           
	<plugins>
	<plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>normalize-serverenv</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete file="${project.basedir}/angular-front-end/src/assets/serverenv.json" quiet="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
	<plugin>
	
        <artifactId>maven-resources-plugin</artifactId>

        <executions>
          <execution>
            <id>copy-serverenv</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
            <skip>${copy.serverenv.in.fe.skip}</skip>
              <outputDirectory>${project.basedir}/angular-front-end/src/assets</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/angular-front-end/src/templates</directory>
                  <includes>
                     <include>serverenv.json</include>
                  </includes>
                
                </resource>
              </resources>
             
            </configuration>
          </execution>
        </executions>
      </plugin>
     
	<plugin>
  <groupId>org.springframework.boot</groupId>
  <artifactId>spring-boot-maven-plugin</artifactId>
  <configuration>
    <systemPropertyVariables>
      <febaseurl>${febaseurl}</febaseurl>
     
       <okta.tenant.id>${okta.tenant.id}</okta.tenant.id>
       <okta.oauth2.client-id>${okta.oauth2.client-id}</okta.oauth2.client-id>
       <okta.oauth2.client-secret>${okta.oauth2.client-secret}</okta.oauth2.client-secret>
    </systemPropertyVariables>
  </configuration>
</plugin>
           
	</plugins>
	</build>
	</profile>
        </profiles>
 <!--
  repositories - Needed while swagger-ui-bff is a -SNAPSHOT (still in development/review):
  Maven Central doesn't serve SNAPSHOTs, so this points at Sonatype's
  snapshot portal instead. Remove once swagger-ui-bff has a stable release.
-->
<repositories>

  <repository>

    <id>central-portal-snapshots</id>

    <url>https://central.sonatype.com/repository/maven-snapshots/</url>

    <releases><enabled>false</enabled></releases>

    <snapshots><enabled>true</enabled></snapshots>

  </repository>

</repositories>


	
</project>